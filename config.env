# ACLClouds Mihomo + Monitor OneClick
# Recommended filename: config.env
#
# ACLClouds Files:
#   File name: config
#   Type: Env (.env)

# ---------------- Monitor ----------------
# MONITOR_TYPE: lite or komari. Komari remains the manually verified default.
MONITOR_ENABLED='1'
MONITOR_TYPE='komari'
MONITOR_ENDPOINT='https://komari.example.com'
MONITOR_TOKEN='REPLACE_WITH_YOUR_AGENT_TOKEN'
MONITOR_REMOTE_CONTROL='false'

MONITOR_VERSION='1.5.11'
MONITOR_URL='https://github.com/komari-monitor/komari-agent/releases/download/1.5.11/komari-agent-linux-amd64'
MONITOR_SHA256='78c28d89e523816baea010c0ed0714f245f508ffdaca0540f5c9f230f7053c8c'

# ---------------- Mihomo ----------------
# Set to 0 for a Monitor-only deployment. Older configs without this field
# remain compatible and continue to enable Mihomo.
MIHOMO_ENABLED='1'
MIHOMO_VERSION='v1.19.31'

# Conservative amd64 v1 build; launcher falls back to compatible if needed.
MIHOMO_URL='https://github.com/MetaCubeX/mihomo/releases/download/v1.19.31/mihomo-linux-amd64-v1-v1.19.31.gz'
MIHOMO_FALLBACK_URL='https://github.com/MetaCubeX/mihomo/releases/download/v1.19.31/mihomo-linux-amd64-compatible-v1.19.31.gz'

MIHOMO_LOGLEVEL='info'
MIHOMO_REMARK='ACLClouds-Free'

# ---------------- VLESS + REALITY ----------------
REALITY_DEST='www.cloudflare.com:443'
REALITY_SNI='www.cloudflare.com'
CLIENT_FINGERPRINT='chrome'
VLESS_FLOW='xtls-rprx-vision'

# Do NOT set SERVER_IP / SERVER_PORT.
# ACLClouds injects them into the container.
